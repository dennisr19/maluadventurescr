---
import { IconArrowLeft, IconClock, IconCoin } from "@tabler/icons-astro";
import { createWhatsappUrl } from "@/data/contact";
import { pageCopy, type Locale } from "@/data/copy";
import type { FeaturedTour } from "@/data/featured-tours";
import { categoryLabels } from "@/data/tours";
import Footer from "./Footer.astro";
import Navigation from "./Navigation.astro";
import TourGallery from "./TourGallery.astro";
import TourPlanning from "./TourPlanning.astro";
import { TourRequestButton } from "./TourRequestButton";

interface Props extends FeaturedTour {
  locale: Locale;
  gallery?: string[];
}

const { locale, tour, image, imageAlt, gallery = [] } = Astro.props;
const copy = pageCopy[locale].featured;
const homeHref = locale === "es" ? "/es/#tours" : "/#tours";
const message =
  locale === "es"
    ? `Hola Malú Adventures, me gustaría solicitar el tour ${tour.name}.`
    : `Hello Malú Adventures, I'd like to request the ${tour.name} tour.`;
const requestHref = createWhatsappUrl(message);
---

<Navigation locale={locale} homeLinks />
<main id="main-content" class="bg-[#FAF8F3] pt-36 sm:pt-40">
  <section aria-labelledby="tour-title" class="px-5 pb-20 sm:px-8 sm:pb-24">
    <div class="mx-auto w-full max-w-6xl">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <a
          href={homeHref}
          class="inline-flex min-h-11 items-center gap-2 text-base font-extrabold text-[#0b6257] transition hover:text-[#073F43]"
        >
          <IconArrowLeft aria-hidden="true" size={24} stroke={2.3} />
          {copy.back}
        </a>
        <span class="h-5 w-px bg-[#b7d5cf]"></span>
        <span class="text-base font-extrabold text-[#285943]">
          {categoryLabels[locale][tour.category]}
        </span>
      </div>

      <header class="pt-7 pb-10">
        <h1
          id="tour-title"
          class="w-full text-balance text-5xl leading-[0.98] font-extrabold tracking-[-0.04em] text-[#073F43] sm:text-6xl lg:w-[58rem] lg:text-7xl"
        >
          {tour.name}
        </h1>
        <p class="mt-6 w-full text-xl leading-8 text-[#496c66] sm:w-[42rem]">{tour.summary}</p>
      </header>

      <div class="relative h-[27rem] overflow-hidden rounded-[2rem] bg-[#dff7f3] shadow-[0_28px_75px_rgba(7,63,67,0.14)] sm:h-[34rem]">
        <img src={image} alt={imageAlt} width="1600" height="900" class="h-full w-full object-cover" />
        <div class="absolute inset-x-0 bottom-0 h-32 bg-linear-to-t from-[#032f32]/38 to-transparent"></div>
      </div>

      <div
        class="relative z-10 mx-3 -mt-12 grid rounded-[1.75rem] bg-[#073F43] p-6 text-[#F1EADC] shadow-[0_24px_60px_rgba(3,47,50,0.24)] sm:mx-8 sm:p-8 lg:mx-12 lg:grid-cols-[0.9fr_1.15fr_auto] lg:items-center lg:gap-8"
      >
        <div class="pb-6 lg:pb-0">
          <div class="flex items-center gap-3 text-base font-extrabold tracking-[0.08em] text-[#72d7d1] uppercase">
            <IconCoin aria-hidden="true" size={27} stroke={2.1} />
            {copy.prices}
          </div>
          <p class="mt-3 text-4xl leading-none font-extrabold tracking-[-0.03em] text-[#F4C45B] sm:text-5xl">
            {tour.priceLabel}
          </p>
          {
            tour.prices.length === 1 && (
              <p class="mt-3 text-base font-semibold text-[#bcd9d4]">{tour.prices[0].label}</p>
            )
          }
          {
            tour.prices.length > 1 && (
              <div class="mt-4 grid gap-1.5">
                {tour.prices.map((price) => (
                  <div class="flex items-baseline justify-between gap-5 text-base">
                    <span class="text-[#bcd9d4]">{price.label}</span>
                    <strong class="text-lg text-white">{price.amount}</strong>
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <div class="border-y border-white/15 py-6 lg:border-y-0 lg:border-l lg:py-0 lg:pl-8">
          <div class="flex items-center gap-3 text-base font-extrabold tracking-[0.08em] text-[#72d7d1] uppercase">
            <IconClock aria-hidden="true" size={27} stroke={2.1} />
            {copy.schedule}
          </div>
          <p class="mt-3 text-lg leading-8 font-bold text-white">
            {tour.schedule?.join(" · ") ?? copy.flexibleSchedule}
          </p>
        </div>

        <TourRequestButton href={requestHref} label={copy.request} />
      </div>
    </div>
  </section>

  <TourGallery
    images={gallery}
    imageAlt={imageAlt}
    title={copy.galleryTitle}
    intro={copy.galleryIntro}
  />
  <TourPlanning title={copy.planningTitle} intro={copy.planningIntro} steps={copy.planningSteps} />
</main>
<Footer locale={locale} />
