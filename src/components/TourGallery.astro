---
interface Props {
  images: string[];
  imageAlt: string;
  title: string;
  intro: string;
}

const { images, imageAlt, title, intro } = Astro.props;
---

{
  images.length > 0 && (
    <section aria-labelledby="tour-gallery-title" class="bg-white px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto w-full max-w-6xl">
        <div class="mb-10 grid gap-4 md:grid-cols-[0.9fr_1.1fr] md:items-end">
          <h2
            id="tour-gallery-title"
            class="text-4xl leading-[1.06] font-extrabold tracking-[-0.04em] text-[#073F43] sm:text-5xl"
          >
            {title}
          </h2>
          <p class="text-lg leading-8 text-[#496c66] md:justify-self-end md:text-right">{intro}</p>
        </div>

        <div class="grid gap-5 md:grid-cols-[1.18fr_0.82fr]">
          {images.slice(0, 2).map((image, index) => (
            <div class="overflow-hidden rounded-[1.75rem] bg-[#dff7f3] shadow-[0_22px_55px_rgba(7,63,67,0.12)]">
              <img
                src={image}
                alt={`${imageAlt} ${index + 2}`}
                width="1200"
                height="900"
                loading="lazy"
                class="aspect-[4/3] w-full object-cover md:h-[32rem]"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
