---
import {
  IconBrandWhatsapp,
  IconCash,
  IconCreditCard,
  IconListCheck,
} from "@tabler/icons-astro";
import { pageCopy, type Locale } from "@/data/copy";
import { PaymentParallax } from "./PaymentParallax";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const copy = pageCopy[locale].payment;
const benefits = [
  { title: copy.cash, body: copy.cashBody, icon: IconCash },
  { title: copy.card, body: copy.cardBody, icon: IconCreditCard },
  { title: copy.direct, body: copy.directBody, icon: IconBrandWhatsapp },
  { title: copy.compare, body: copy.compareBody, icon: IconListCheck },
];
---

<section
  id="payment"
  aria-labelledby="payment-title"
  class="relative isolate overflow-hidden bg-[#073F43] px-5 py-24 text-[#F1EADC] sm:px-8 sm:py-28"
>
  <PaymentParallax client:visible />

  <div class="relative mx-auto grid w-full max-w-6xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-20">
    <div>
      <p class="text-sm font-extrabold tracking-[0.16em] text-[#78ddd6] uppercase sm:text-base">
        {copy.eyebrow}
      </p>
      <h2
        id="payment-title"
        class="mt-3 text-4xl leading-[1.05] font-extrabold tracking-[-0.04em] text-[#F1EADC] sm:text-5xl"
      >
        {copy.title}
      </h2>
      <p class="mt-5 text-lg leading-8 font-medium text-white/85">{copy.intro}</p>
    </div>

    <div class="grid gap-x-8 sm:grid-cols-2">
      {
        benefits.map(({ title, body, icon: BenefitIcon }, index) => (
          <div
            class:list={[
              "flex gap-4 border-white/25 py-6",
              index < 2 && "border-b",
              index % 2 === 1 && "sm:pl-2",
            ]}
          >
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-[#F1EADC] text-[#073F43] shadow-[0_10px_26px_rgba(1,28,29,0.2)]">
              <BenefitIcon aria-hidden="true" size={23} stroke={2} />
            </span>
            <div>
              <h3 class="text-lg font-extrabold text-white">{title}</h3>
              <p class="mt-1 text-base leading-7 font-medium text-white/80">{body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
