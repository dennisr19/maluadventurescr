---
import { contact, whatsappUrl } from "@/data/contact";
import { pageCopy, type Locale } from "@/data/copy";
import { ContactAction } from "./ContactAction";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const copy = pageCopy[locale].contact;
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="bg-linear-to-b from-[#FAF8F3] from-50% to-[#032f32] to-50% px-5 py-20 sm:px-8 sm:py-24"
>
  <div class="mx-auto w-full max-w-6xl">
    <div
      class="relative mx-auto w-full overflow-hidden rounded-[2rem] bg-[#073F43] px-7 py-12 text-center text-white shadow-[0_28px_70px_rgba(3,47,50,0.24)] ring-1 ring-[#36BFB7]/20 sm:px-10 sm:py-14 lg:px-16 xl:w-[64rem]"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-24 -left-20 size-60 rounded-full border-[30px] border-[#36BFB7]/10"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-10 -bottom-20 size-48 rounded-full border-[24px] border-[#F4C45B]/10"
      >
      </div>
      <h2
        id="contact-title"
        class="relative text-4xl leading-[1.05] font-extrabold tracking-[-0.04em] sm:text-5xl"
      >
        {copy.title}
      </h2>
      <p class="relative mx-auto mt-5 w-full text-lg leading-8 text-[#cce3df] sm:w-[38rem]">
        {copy.body}
      </p>
      <div class="relative mx-auto mt-8 flex w-full justify-center">
        <ContactAction href={whatsappUrl} label={`${copy.message} ${contact.phoneDisplay}`} />
      </div>
    </div>
  </div>
</section>
